{
  "schema": "natlang.package/v2",
  "name": "google-workspace-workflow",
  "version": "0.1.0",
  "description": "Readiness, Drive review and change continuation in a caller-owned Google Workspace.",
  "targets": {
    "main": {
      "entry": "guideGoogleWorkspace.nl"
    }
  },
  "serviceBinding": "explicit",
  "serviceScopes": {
    "driveCheckpoint": [],
    "googleWorkspaceRead": [
      "guideGoogleWorkspace.nl",
      "guideGoogleWorkspace/inspectFolder.nl",
      "guideGoogleWorkspace/reviewSharing.nl",
      "guideGoogleWorkspace/continueSync.nl"
    ],
    "googleGoalDiscovery": [
      "workOnDriveGoal.ts"
    ],
    "googleSetupPanel": []
  }
}
